# API ключ OpenRouter (https://openrouter.ai/)
OPENROUTER_API_KEY=
# Id модели с openrouter.ai/models. В HK и ряде регионов openai/* часто недоступны.
# OPENROUTER_MODEL=deepseek/deepseek-chat-v3-0324

# Либо одна строка (локально), либо POSTGRES_* — так в Docker / Coolify без подстановки YAML.
DATABASE_URL=postgresql+asyncpg://postgres:postgres123@localhost:5432/crs_agent
# POSTGRES_HOST=localhost
# POSTGRES_PORT=5432
# POSTGRES_USER=postgres
# POSTGRES_PASSWORD=postgres123
# POSTGRES_DB=crs_agent
RAG_URL=http://localhost:8001/api/v1
ROUTE_URL=http://localhost:8003
# Если не задано, в коде включены localhost и https://crista.online (см. app/main.py)
# CORS_ORIGINS=http://localhost:5173,http://localhost:3333
JWT_SECRET=change-me-min-32-chars-please-use-openssl-rand-hex-32

# Trusted price feeds use a JSON object mapping a source identifier to its HTTPS feed URL.
# Every feed URL and every price item's source_url must match PRICE_SOURCE_ALLOWLIST.
# Feed payload: {"prices":[{"subject_key":"flight-mow-led","amount_minor":1234500,"currency":"RUB","source_url":"https://prices.example.com/offers/flight-mow-led","ttl_seconds":21600}]}
# PRICE_SOURCE_ALLOWLIST=partner_prices=prices.example.com
# PRICE_SOURCE_FEEDS={"partner_prices":"https://prices.example.com/feed.json"}
